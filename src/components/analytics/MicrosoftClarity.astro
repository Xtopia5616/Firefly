---
interface Props {
	clarityId: string;
}

const { clarityId } = Astro.props;
---

<script is:inline data-swup-ignore-script define:vars={{ clarityId }}>
    function initClarity() {
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", clarityId);
    }
    function startClarity() {
        if (window.requestIdleCallback) {
            window.requestIdleCallback(initClarity, { timeout: 3000 });
        } else {
            setTimeout(initClarity, 0);
        }
    }
    // 页面加载完成后再加载 Clarity，避免拖慢首屏加载
    if (document.readyState === "complete") {
        startClarity();
    } else {
        window.addEventListener("load", startClarity, { once: true });
    }
</script>